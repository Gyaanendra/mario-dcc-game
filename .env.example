# Export these variables in the server process environment. This file is not loaded automatically.
PORT=3001
NODE_ENV=production
DATA_DIR=/var/lib/mario-career-quest
PUBLIC_JOIN_URL=https://your-event-domain.example/play
HOST_PIN=replace-with-a-unique-12-plus-character-secret
JUDGE_NAMES=DCC Judge
# Only for a separate rehearsal server and database:
TEST_MODE=0
