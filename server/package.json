{
  "name": "mario-career-quest-server",
  "version": "1.0.0",
  "type": "module",
  "description": "Ultra-lightweight real-time Fastify + WS + SQLite server for Mario Career Quest",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "seed": "tsx src/seed.ts",
    "test": "tsx --test src/*.test.ts",
    "test:load": "tsx src/loadTest.ts",
    "export:fallback": "tsx src/exportFallback.ts",
    "backup": "tsx src/backup.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.8",
    "@fastify/websocket": "^11.0.2",
    "fastify": "^5.2.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
